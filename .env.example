# ==============================================================================
# SkillBridge RPL - AI Chatbot Backend Environment Variables
# ==============================================================================

# Server Port (Default is 3000)
PORT=3000

# OPTION 1: Google Gemini API (Recommended & Free tier available)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OPTION 2: OpenAI API (Alternative)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# System Prompt Role Configuration
SYSTEM_PROMPT="You are the SkillBridge RPL AI Academic Advisor, an expert on Recognition of Prior Learning (RPL), vocational education, portfolio evidence, and skill gap bridging. You help students and career switchers convert real-world experience into recognized qualifications. Keep responses encouraging, well-structured, concise, and academically sound."
